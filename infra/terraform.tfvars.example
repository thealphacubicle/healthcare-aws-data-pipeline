# Copy to terraform.tfvars (gitignored) and fill in.
alert_email     = "you@example.com"
drive_folder_id = "REPLACE_WITH_DRIVE_FOLDER_ID"

# AWS-managed layer with pandas + pyarrow. Use the current ARN for your region
# from https://aws-sdk-pandas.readthedocs.io/en/stable/layers.html
aws_sdk_pandas_layer_arn = "arn:aws:lambda:us-east-1:336392948345:layer:AWSSDKPandas-Python312:REPLACE_VERSION"

# Optional overrides
# aws_region                 = "us-east-1"
# ingest_schedule_expression = "cron(0 6 * * ? *)"
# dashboard_allowed_cidrs    = ["203.0.113.10/32"] # default: SSM port forwarding only
# monthly_budget_usd         = "0.01"
